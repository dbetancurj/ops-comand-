rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permite lectura y escritura a usuarios autenticados (incluyendo anónimos)
    match /ops_sprint_tasks/{docId} {
      allow read, write: if request.auth != null;
    }
    match /ops_op_tasks/{docId} {
      allow read, write: if request.auth != null;
    }
    match /ops_sprints/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
